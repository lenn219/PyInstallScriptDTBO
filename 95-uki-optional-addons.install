#!/usr/bin/env python3
# /etc/kernel/install.d/95-uki-optional-addons.install

import os
import shutil
import sys
from pathlib import Path
import logging 

# UKI addon Path
LIST_FILE = Path("/etc/kernel/uki-optional-addons")
# -v van de kernel install
#VERBOSE = os.environ.get("KERNEL_INSTALL_VERBOSE", "0") not in ("", "0")
VERBOSE = 1

# voor loggen heb ik dit gedaan denk dat het de beste manier is.
logger = logging.getLogger(__name__)
if VERBOSE:
    logging.basicConfig(level=logging.DEBUG)
else: 
    logging.basicConfig(level=logging.ERROR)

def read_list(path: Path) -> list[str]:
    # Lees de addon-lijst; lege regels en commentaar overslaan. 
    if not path.is_file():
        logger.debug(f"{path} bestaat niet, niks te doen")
        return []

    names: list[str] = []
    try:
        for raw in path.read_text(encoding="utf-8").splitlines():
            name = raw.split("#", 1)[0].strip()
            if not name:
                continue

            if "/" in name or "\\" in name or name in (".", "..") or not name:
                logger.error(f"ongeldige naam '{name}' in {path}, overgeslagen")
                continue
            names.append(name)
    except OSError as e:
        logger.error(f"kan {path} niet lezen: {e}")
        return []

    return names

# Dit is om vanuit de env te lezen.
def get_dest_dir(kver: str) -> Path | None:
    boot = os.environ.get("KERNEL_INSTALL_BOOT_ROOT")
    token = os.environ.get("KERNEL_INSTALL_ENTRY_TOKEN")
    if not boot or not token:
        logger.error("KERNEL_INSTALL_BOOT_ROOT of ENTRY_TOKEN ontbreekt, overgeslagen")
        return None

    entry_name = os.environ.get("KERNEL_INSTALL_ENTRY_NAME") or f"{token}-{kver}"
    return Path(boot) / "EFI" / "Linux" / f"{entry_name}.efi.extra.d"

# Dit onderdeel handelt all code voor het verwijderen van de Install Script
def do_add(kver: str, kernel_image: str) -> None:
    src = Path(f"{kernel_image}.extra.optional.d")
    names = read_list(LIST_FILE)
    if not names:
        return

    dest = get_dest_dir(kver)
    if dest is None:
        return

    if not src.is_dir():
        logger.error(f"bronmap {src} bestaat niet voor kernel {kver}")
        return

    dest.mkdir(parents=True, exist_ok=True)

    for name in names:
        src_file = src / name
        if not src_file.is_file():
            logger.error(f"'{name}' staat in de lijst {LIST_FILE} maar niet in {src}")
            continue

        target = dest / name
        logger.debug(f"{src_file} -> {target}")
        try:
            # ESP is FAT: geen rechten/metadata kopiëren
            shutil.copyfile(src_file, target)
        except OSError as e:
            logger.exception(f"kon {src_file} niet kopiëren naar {target}: {e}")

# Dit onderdeel handelt all code voor het verwijderen van de Install Script
def do_remove(kver: str) -> None:
    dest = get_dest_dir(kver)
    if dest is None or not dest.is_dir():
        return

    names = set(read_list(LIST_FILE))
    if not names:
        return

    for name in names:
        target = dest / name
        if target.is_file():
            logger.debug(f"verwijder {target}")
            try:
                target.unlink()
            except OSError as e:
                logger.exception(f"kon {target} niet verwijderen: {e}")

    # Alleen de map verwijderen als die nu leeg is
    try:
        dest.rmdir()
        logger.debug(f"lege map verwijderd: {dest}")
    except OSError:
        logger.exception(f"Nog bestanden aanwezig na het verwijderen?")
        pass


def main() -> int:
    if len(sys.argv) < 5:
        logger.error("Not Enough Command line arguments")
        return 0

    cmd = sys.argv[1]
    kver = sys.argv[2]

    if os.environ.get("KERNEL_INSTALL_LAYOUT") != "uki":
        logger.error("layout is geen uki, overgeslagen")
        return 0

    if cmd == "add":
        logger.debug("Add command word uitgevoerd")
        do_add(kver, sys.argv[4])
    elif cmd == "remove":
        logger.debug("Remove command word uitgevoerd")
        do_remove(kver)
    else:
        logger.debug(f"onbekend commando '{cmd}', overgeslagen")

    return 0


if __name__ == "__main__":
    sys.exit(main())