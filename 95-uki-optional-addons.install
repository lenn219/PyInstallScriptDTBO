#!/usr/bin/env python3
# /etc/kernel/install.d/95-uki-optional-addons.install
#
# Installeert optionele UKI-addons per kernelversie.
#   Bron:  $KERNEL_IMAGE.extra.optional.d/*.addon.efi
#   Lijst: /etc/kernel/uki-optional-addons  (één bestandsnaam per regel, # = commentaar)
#   Doel:  $BOOT_ROOT/EFI/Linux/<entry-naam>.efi.extra.d/
#
# Aanroep door kernel-install:
#   add    <kver> <entry-dir> <kernel-image> [initrd...]
#   remove <kver> <entry-dir>

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

# UKI addon Path
LIST_FILE = Path("/etc/kernel/uki-optional-addons")
# -v van de kernel install
VERBOSE = os.environ.get("KERNEL_INSTALL_VERBOSE", "0") not in ("", "0")

# Debugging informatie.
def log(msg: str) -> None:
    if VERBOSE:
        print(f"uki-optional-addons: {msg}", file=sys.stderr)

# Barf het direct uit Niet indirect
def warn(msg: str) -> None:
    print(f"uki-optional-addons: WAARSCHUWING: {msg}", file=sys.stderr)


def read_list(path: Path) -> list[str]:
    """Lees de addon-lijst; lege regels en commentaar overslaan."""
    if not path.is_file():
        log(f"{path} bestaat niet, niks te doen")
        return []

    names: list[str] = []
    try:
        for raw in path.read_text(encoding="utf-8").splitlines():
            name = raw.split("#", 1)[0].strip()
            if not name:
                continue
            # Veiligheid: alleen kale bestandsnamen toestaan
            if "/" in name or "\\" in name or name in (".", "..") or not name:
                warn(f"ongeldige naam '{name}' in {path}, overgeslagen")
                continue
            names.append(name)
    except OSError as e:
        warn(f"kan {path} niet lezen: {e}")
        return []

    return names

# Dit is om vanuit de env te lezen.
def get_dest_dir(kver: str) -> Path | None:
    boot = os.environ.get("KERNEL_INSTALL_BOOT_ROOT")
    token = os.environ.get("KERNEL_INSTALL_ENTRY_TOKEN")
    if not boot or not token:
        warn("KERNEL_INSTALL_BOOT_ROOT of ENTRY_TOKEN ontbreekt, overgeslagen")
        return None

    entry_name = os.environ.get("KERNEL_INSTALL_ENTRY_NAME") or f"{token}-{kver}"
    return Path(boot) / "EFI" / "Linux" / f"{entry_name}.efi.extra.d"

# Dit onderdeel handelt all code voor het verwijderen van de Install Script
def do_add(kver: str, kernel_image: str) -> None:
    src = Path(f"{kernel_image}.extra.optional.d")
    names = read_list(LIST_FILE)
    if not names:
        return

    dest = get_dest_dir(kver)
    if dest is None:
        return

    if not src.is_dir():
        warn(f"bronmap {src} bestaat niet voor kernel {kver}")
        return

    dest.mkdir(parents=True, exist_ok=True)

    for name in names:
        src_file = src / name
        if not src_file.is_file():
            warn(f"'{name}' staat in de lijst maar niet in {src}")
            continue

        target = dest / name
        log(f"{src_file} -> {target}")
        try:
            # ESP is FAT: geen rechten/metadata kopiëren
            shutil.copyfile(src_file, target)
        except OSError as e:
            warn(f"kon {src_file} niet kopiëren naar {target}: {e}")

# Dit onderdeel handelt all code voor het verwijderen van de Install Script
def do_remove(kver: str) -> None:
    dest = get_dest_dir(kver)
    if dest is None or not dest.is_dir():
        return

    names = set(read_list(LIST_FILE))
    if not names:
        return

    for name in names:
        target = dest / name
        if target.is_file():
            log(f"verwijder {target}")
            try:
                target.unlink()
            except OSError as e:
                warn(f"kon {target} niet verwijderen: {e}")

    # Alleen de map verwijderen als die nu leeg is
    try:
        dest.rmdir()
        log(f"lege map verwijderd: {dest}")
    except OSError:
        pass  # nog bestanden aanwezig of andere fout → negeren


def main() -> int:
    if len(sys.argv) < 3:
        log("Not Enough Command line arguments")
        return 0

    cmd = sys.argv[1]
    kver = sys.argv[2]

    if os.environ.get("KERNEL_INSTALL_LAYOUT") != "uki":
        log("layout is geen uki, overgeslagen")
        return 0

    if cmd == "add":
        log("Add command word uitgevoerd")
        if len(sys.argv) < 5:
            warn("geen KERNEL_IMAGE meegegeven, overgeslagen")
            return 0
        do_add(kver, sys.argv[4])
    elif cmd == "remove":
        log("Remove command word uitgevoerd")
        do_remove(kver)
    else:
        log(f"onbekend commando '{cmd}', overgeslagen")

    return 0


if __name__ == "__main__":
    sys.exit(main())